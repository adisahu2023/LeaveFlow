# Local development only. Replace placeholders with your own values.
DB_URL=jdbc:mysql://localhost:3306/practicedb
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Generate a strong Base64-encoded random secret (at least 32 random bytes).
# Do not use the old secret from the previous application.properties.
JWT_SECRET=REPLACE_WITH_A_NEW_BASE64_SECRET
